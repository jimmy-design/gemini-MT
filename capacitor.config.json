{
  "appId": "com.wave.messenger",
  "appName": "Wave",
  "webDir": "dist",
  "bundledWebRuntime": false,
  "server": {
    "iosScheme": "https"
  },
  "ios": {
    "contentInset": "always"
  },
  "plugins": {
    "SplashScreen": {
      "launchShowDuration": 1200,
      "backgroundColor": "#ffffff",
      "showSpinner": false
    },
    "StatusBar": {
      "style": "LIGHT",
      "backgroundColor": "#ffffff"
    }
  }
}
